---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Publishing Studio" description="Private publishing studio." noindex>
  <section class="page section admin-page">
    <header class="admin-heading">
      <p class="mono text-secondary">Private publishing studio</p>
      <h1>Write and publish</h1>
      <p class="text-secondary">Create Blog posts and Security Write-ups without touching Markdown or Git.</p>
    </header>

    <div id="login-panel" class="admin-panel">
      <h2>Sign in to continue</h2>
      <p class="text-secondary">Only the configured GitHub account can access publishing.</p>
      <a class="admin-button admin-button-primary" href="/.netlify/functions/admin-auth?route=start">Continue with GitHub</a>
      <p id="login-error" class="form-status is-error" hidden></p>
    </div>

    <div id="admin-app" hidden>
      <div class="dashboard-toolbar">
        <div>
          <strong id="user-name"></strong>
          <span class="text-secondary"> · Publishing dashboard</span>
        </div>
        <div class="toolbar-actions">
          <button id="new-blog" class="admin-button admin-button-secondary" type="button">Add Blog</button>
          <button id="new-writeup" class="admin-button admin-button-secondary" type="button">Add Write-up</button>
          <button id="logout" class="admin-button admin-button-quiet" type="button">Sign out</button>
        </div>
      </div>

      <div class="stats-grid">
        <div class="stat-card"><strong id="published-count">0</strong><span>Published</span></div>
        <div class="stat-card"><strong id="draft-count">0</strong><span>Drafts</span></div>
        <div class="stat-card"><strong id="total-count">0</strong><span>Total articles</span></div>
      </div>

      <div class="dashboard-layout">
        <aside class="admin-panel article-list-panel">
          <div class="list-heading">
            <h2>Articles</h2>
            <select id="collection-filter" aria-label="Filter by collection">
              <option value="all">All content</option>
              <option value="blog">Blog</option>
              <option value="writeups">Write-ups</option>
            </select>
          </div>
          <input id="article-search" type="search" placeholder="Search articles..." />
          <p id="list-status" class="text-secondary">Loading...</p>
          <div id="article-list"></div>
        </aside>

        <main class="editor-panel">
          <form id="article-form" class="admin-panel">
            <div class="editor-top">
              <div>
                <p id="editor-mode" class="mono text-secondary">New article</p>
                <h2 id="editor-heading">Choose Blog or Write-up</h2>
              </div>
              <div class="editor-actions">
                <button id="preview-button" class="admin-button admin-button-secondary" type="button">Preview</button>
                <button id="delete-button" class="admin-button admin-button-danger" type="button" hidden>Delete</button>
              </div>
            </div>

            <div class="field-grid">
              <label>Title<input id="title" required maxlength="180" /></label>
              <label>Slug<input id="slug" required maxlength="90" pattern="[a-z0-9-]+" /></label>
            </div>
            <div class="field-grid">
              <label>Description / excerpt<textarea id="description" rows="2" maxlength="300" required></textarea></label>
              <label>Publication date<input id="date" type="date" required /></label>
            </div>
            <div class="field-grid">
              <label>Tags <span class="field-help">comma separated</span><input id="tags" placeholder="web security, research" /></label>
              <label>Cover image<input id="cover-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" /><small id="cover-status">Optional</small></label>
            </div>

            <fieldset id="blog-fields" hidden>
              <legend>Blog metadata</legend>
              <div class="field-grid">
                <label>Category<input id="blog-category" placeholder="Research, career, learning..." /></label>
                <label>SEO title<input id="seo-title" maxlength="180" /></label>
              </div>
              <label>SEO description<textarea id="seo-description" rows="2" maxlength="300"></textarea></label>
            </fieldset>

            <fieldset id="writeup-fields" hidden>
              <legend>Write-up metadata</legend>
              <div class="field-grid">
                <label>Vulnerability type<select id="category">
                  <option value="web">Web</option><option value="api">API</option><option value="auth">Authentication</option>
                  <option value="misconfig">Misconfiguration</option><option value="recon">Recon</option><option value="other">Other</option>
                </select></label>
                <label>Severity<select id="severity">
                  <option value="">Not specified</option><option>informational</option><option>low</option><option>medium</option><option>high</option><option>critical</option>
                </select></label>
              </div>
              <div class="field-grid">
                <label>Target / platform<input id="target" /></label>
                <label>Difficulty<select id="difficulty"><option value="">Not specified</option><option>easy</option><option>medium</option><option>hard</option></select></label>
              </div>
              <label>Tools used <span class="field-help">comma separated</span><input id="technologies" placeholder="Burp Suite, HTTP, Nmap" /></label>
              <label>References <span class="field-help">one URL per line</span><textarea id="references" rows="2"></textarea></label>
            </fieldset>

            <div class="editor-toolbar" aria-label="Formatting toolbar">
              <button type="button" data-command="paragraph">P</button>
              <button type="button" data-command="h1">H1</button><button type="button" data-command="h2">H2</button><button type="button" data-command="h3">H3</button>
              <button type="button" data-command="bold"><strong>B</strong></button><button type="button" data-command="italic"><em>I</em></button>
              <button type="button" data-command="underline"><u>U</u></button><button type="button" data-command="strike"><s>S</s></button>
              <button type="button" data-command="code">Code</button><button type="button" data-command="blockquote">Quote</button>
              <button type="button" data-command="bullet">• List</button><button type="button" data-command="ordered">1. List</button>
              <button type="button" data-command="link">Link</button><button type="button" data-command="image">Image</button>
              <button type="button" data-command="table">Table</button><button type="button" data-command="hr">Divider</button>
              <select id="code-language" aria-label="Code language">
                <option value="">Code language</option><option>python</option><option>javascript</option><option>typescript</option>
                <option>bash</option><option>sql</option><option>json</option><option>html</option><option>css</option><option>php</option><option>http</option>
              </select>
            </div>
            <div id="editor" class="rich-editor" aria-label="Article content"></div>
            <div class="editor-footer">
              <span id="word-count" class="text-secondary">0 words · 1 min read</span>
              <span id="save-status" class="text-secondary" role="status"></span>
              <div class="editor-actions">
                <button id="save-draft" class="admin-button admin-button-secondary" type="button">Save draft</button>
                <button id="publish" class="admin-button admin-button-primary" type="submit">Publish</button>
              </div>
            </div>
            <p id="form-status" class="form-status" role="status"></p>
          </form>
        </main>
      </div>
    </div>
  </section>

  <dialog id="preview-dialog" class="preview-dialog">
    <form method="dialog"><button class="close-button" aria-label="Close preview">×</button></form>
    <article id="preview-content" class="article-body"></article>
  </dialog>
</BaseLayout>

<script>
  // @ts-nocheck
  import { Editor } from '@tiptap/core';
  import StarterKit from '@tiptap/starter-kit';
  import Link from '@tiptap/extension-link';
  import Underline from '@tiptap/extension-underline';
  import Image from '@tiptap/extension-image';
  import { Table } from '@tiptap/extension-table';
  import TableRow from '@tiptap/extension-table-row';
  import TableCell from '@tiptap/extension-table-cell';
  import TableHeader from '@tiptap/extension-table-header';
  import Placeholder from '@tiptap/extension-placeholder';
  import CodeBlockLowlight from '@tiptap/extension-code-block-lowlight';
  import { common, createLowlight } from 'lowlight';
  import TurndownService from 'turndown';
  import { marked } from 'marked';

  const api = '/.netlify/functions/admin-api';
  const auth = '/.netlify/functions/admin-auth';
  const $ = (id) => document.getElementById(id);
  const state = { collection: null, current: null, csrf: '', articles: [] };
  const lowlight = createLowlight(common);
  const turndown = new TurndownService({ headingStyle: 'atx', codeBlockStyle: 'fenced', bulletListMarker: '-' });
  turndown.addRule('fencedCode', {
    filter: 'pre',
    replacement: (content, node) => {
      const code = node.querySelector('code');
      const language = code?.className.match(/language-([\w-]+)/)?.[1] || '';
      return `\n\n\`\`\`${language}\n${code?.textContent || content}\n\`\`\`\n\n`;
    },
  });

  function setText(id, value) { $(id).textContent = value; }
  function list(value) { return value.split(',').map((item) => item.trim()).filter(Boolean); }
  function slugify(value) { return value.toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 80) || 'article'; }
  function errorMessage(error) { return error instanceof Error ? error.message : 'Request failed.'; }
  function setStatus(message, error = false) { const el = $('form-status'); el.textContent = message; el.classList.toggle('is-error', error); }
  function setEditorMode(collection) {
    state.collection = collection;
    $('blog-fields').hidden = collection !== 'blog';
    $('writeup-fields').hidden = collection !== 'writeups';
    $('editor-heading').textContent = collection === 'blog' ? 'Blog post' : 'Security write-up';
    $('editor-mode').textContent = state.current ? `Editing ${state.current.name}` : `New ${collection === 'blog' ? 'Blog post' : 'Write-up'}`;
  }
  function updateCount() {
    const text = editor.getText().trim();
    const words = text ? text.split(/\s+/).length : 0;
    setText('word-count', `${words} words · ${Math.max(1, Math.round(words / 200))} min read`);
  }
  async function request(url, options = {}) {
    const response = await fetch(url, { credentials: 'same-origin', ...options, headers: { ...(options.headers || {}), ...(options.method && options.method !== 'GET' ? { 'x-csrf-token': state.csrf } : {}) } });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || 'Request failed.');
    return data;
  }
  function frontmatter(fields, body) {
    const lines = ['---', `title: ${JSON.stringify(fields.title)}`, `description: ${JSON.stringify(fields.description)}`, `date: ${fields.date}`, `slug: ${JSON.stringify(fields.slug)}`, `tags: ${JSON.stringify(fields.tags)}`, `draft: ${fields.draft}`, 'confidentiality: "public"'];
    if (fields.coverUrl) lines.push(`coverUrl: ${JSON.stringify(fields.coverUrl)}`);
    if (state.collection === 'blog') {
      if (fields.category) lines.push(`category: ${JSON.stringify(fields.category)}`);
      if (fields.seoTitle) lines.push(`seoTitle: ${JSON.stringify(fields.seoTitle)}`);
      if (fields.seoDescription) lines.push(`seoDescription: ${JSON.stringify(fields.seoDescription)}`);
    } else {
      lines.push(`category: ${JSON.stringify(fields.category || 'other')}`);
      if (fields.severity) lines.push(`severity: ${JSON.stringify(fields.severity)}`);
      if (fields.target) lines.push(`target: ${JSON.stringify(fields.target)}`);
      if (fields.difficulty) lines.push(`difficulty: ${JSON.stringify(fields.difficulty)}`);
      lines.push(`technologies: ${JSON.stringify(fields.technologies)}`);
      lines.push(`references: ${JSON.stringify(fields.references)}`);
      lines.push('featured: false');
    }
    return `${lines.join('\n')}\n---\n\n${body.trim()}\n`;
  }
  function fieldsFromForm(draft) {
    return {
      title: $('title').value.trim(), slug: slugify($('slug').value.trim()), description: $('description').value.trim(),
      date: $('date').value, tags: list($('tags').value), draft, coverUrl: state.coverUrl || '',
      category: state.collection === 'blog' ? $('blog-category').value.trim() : $('category').value,
      seoTitle: $('seo-title').value.trim(), seoDescription: $('seo-description').value.trim(),
      severity: $('severity').value, target: $('target').value.trim(), difficulty: $('difficulty').value,
      technologies: list($('technologies').value), references: $('references').value.split('\n').map((v) => v.trim()).filter(Boolean),
    };
  }
  function fill(fields, body) {
    $('title').value = fields.title || ''; $('slug').value = fields.slug || slugify(fields.title || '');
    $('description').value = fields.description || ''; $('date').value = fields.date || new Date().toISOString().slice(0, 10);
    $('tags').value = (fields.tags || []).join(', '); $('blog-category').value = fields.category || '';
    $('seo-title').value = fields.seoTitle || ''; $('seo-description').value = fields.seoDescription || '';
    $('category').value = fields.category || 'web'; $('severity').value = fields.severity || '';
    $('target').value = fields.target || ''; $('difficulty').value = fields.difficulty || '';
    $('technologies').value = (fields.technologies || []).join(', '); $('references').value = (fields.references || []).join('\n');
    state.coverUrl = fields.coverUrl || ''; $('cover-status').textContent = state.coverUrl || 'Optional';
    editor.commands.setContent(body ? marked.parse(body) : '');
    updateCount();
  }
  function articleButton(article) {
    const button = document.createElement('button'); button.type = 'button'; button.className = 'article-list-item';
    button.innerHTML = `<strong>${article.title || article.name}</strong><span>${article.draft ? 'Draft' : 'Published'} · ${article.date || ''}</span>`;
    button.addEventListener('click', () => loadArticle(article)); return button;
  }
  async function loadList() {
    const collections = state.collection ? [state.collection] : ['blog', 'writeups'];
    const results = (await Promise.all(collections.map((collection) => request(`${api}?action=list&collection=${collection}`).then((items) => items.map((item) => ({ ...item, collection })) )))).flat();
    state.articles = results; renderList(); updateStats();
  }
  function renderList() {
    const term = $('article-search').value.toLowerCase(); const filter = $('collection-filter').value;
    const listEl = $('article-list'); listEl.replaceChildren();
    const items = state.articles.filter((item) => (!term || `${item.title} ${item.description}`.toLowerCase().includes(term)) && (filter === 'all' || item.collection === filter));
    setText('list-status', `${items.length} article${items.length === 1 ? '' : 's'}`);
    items.forEach((item) => listEl.append(articleButton(item)));
  }
  function updateStats() {
    setText('published-count', state.articles.filter((item) => !item.draft).length);
    setText('draft-count', state.articles.filter((item) => item.draft).length);
    setText('total-count', state.articles.length);
  }
  async function loadArticle(article) {
    const data = await request(`${api}?action=read&collection=${article.collection}&path=${encodeURIComponent(article.path)}`);
    state.current = { ...article, sha: data.sha }; setEditorMode(article.collection);
    const parsed = data.content.match(/^---\s*\n([\s\S]*?)\n---\s*\n?([\s\S]*)$/); const fields = {};
    if (parsed) parsed[1].split('\n').forEach((line) => { const i = line.indexOf(':'); if (i > 0) { const key = line.slice(0, i).trim(); const raw = line.slice(i + 1).trim(); try { fields[key] = JSON.parse(raw); } catch { fields[key] = raw.replace(/^['"]|['"]$/g, ''); } } });
    fill(fields, parsed ? parsed[2] : data.content); $('delete-button').hidden = false; setText('save-status', 'Loaded');
  }
  async function upload(file) {
    const bytes = new Uint8Array(await file.arrayBuffer()); let binary = ''; bytes.forEach((byte) => { binary += String.fromCharCode(byte); });
    const data = await request(`${api}?action=upload&collection=${state.collection}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'upload', collection: state.collection, slug: $('slug').value, name: file.name.replace(/[^a-zA-Z0-9_.-]/g, '-'), contentBase64: btoa(binary) }) });
    state.coverUrl = data.url; setText('cover-status', `Uploaded: ${data.url}`);
  }
  async function insertImage(file) {
    const bytes = new Uint8Array(await file.arrayBuffer()); let binary = ''; bytes.forEach((byte) => { binary += String.fromCharCode(byte); });
    const data = await request(`${api}?action=upload&collection=${state.collection}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'upload', collection: state.collection, slug: $('slug').value, name: file.name.replace(/[^a-zA-Z0-9_.-]/g, '-'), contentBase64: btoa(binary) }) });
    editor.chain().focus().setImage({ src: data.url, alt: file.name }).run();
  }
  async function save(draft) {
    if (!state.collection) throw new Error('Choose Blog or Write-up first.');
    const fields = fieldsFromForm(draft); if (!fields.title || !fields.description || !fields.date || !editor.getText().trim()) throw new Error('Title, description, date, and content are required.');
    const content = frontmatter(fields, turndown.turndown(editor.getHTML()));
    const targetPath = `src/content/${state.collection}/${fields.slug}.md`;
    const sameFile = state.current?.path === targetPath;
    const data = await request(`${api}?action=save&collection=${state.collection}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'save', collection: state.collection, ...fields, content, sha: sameFile ? state.current?.sha : undefined, previousPath: sameFile ? undefined : state.current?.path, previousSha: sameFile ? undefined : state.current?.sha }) });
    state.current = { ...(state.current || {}), name: data.path.split('/').pop(), path: data.path, sha: data.sha, collection: state.collection, ...fields };
    setText('save-status', draft ? 'Draft saved' : 'Published'); setStatus(draft ? 'Draft saved to GitHub.' : 'Published successfully. GitHub Pages will deploy the update.');
    await loadList();
  }
  const editor = new Editor({ element: $('editor'), extensions: [StarterKit, Underline, Link.configure({ openOnClick: false }), Image.configure({ allowBase64: false }), Table.configure({ resizable: true }), TableRow, TableHeader, TableCell, Placeholder.configure({ placeholder: 'Start writing... Type / or use the toolbar.' }), CodeBlockLowlight.configure({ lowlight })], content: '' });
  editor.on('update', updateCount);
  document.querySelectorAll('[data-command]').forEach((button) => button.addEventListener('click', () => {
    const command = button.dataset.command; const chain = editor.chain().focus();
    ({ paragraph: () => chain.setParagraph(), h1: () => chain.setHeading({ level: 1 }), h2: () => chain.setHeading({ level: 2 }), h3: () => chain.setHeading({ level: 3 }), bold: () => chain.toggleBold(), italic: () => chain.toggleItalic(), underline: () => chain.toggleUnderline(), strike: () => chain.toggleStrike(), code: () => chain.toggleCode(), blockquote: () => chain.toggleBlockquote(), bullet: () => chain.toggleBulletList(), ordered: () => chain.toggleOrderedList(), hr: () => chain.setHorizontalRule(), table: () => chain.insertTable({ rows: 3, cols: 3, withHeaderRow: true }), link: () => { const href = prompt('URL'); return href ? chain.setLink({ href }) : chain; }, image: () => $('image-file').click() }[command] || (() => chain))().run();
  }));
  $('code-language').addEventListener('change', (event) => editor.chain().focus().setCodeBlock({ language: event.target.value }).run());
  const imageInput = document.createElement('input'); imageInput.type = 'file'; imageInput.accept = 'image/*'; imageInput.hidden = true; imageInput.id = 'image-file'; document.body.append(imageInput);
  imageInput.addEventListener('change', async () => { if (!imageInput.files[0]) return; try { await insertImage(imageInput.files[0]); } catch (error) { setStatus(errorMessage(error), true); } });
  $('editor').addEventListener('dragover', (event) => { event.preventDefault(); });
  $('editor').addEventListener('drop', async (event) => { event.preventDefault(); const file = [...event.dataTransfer.files].find((item) => item.type.startsWith('image/')); if (!file) return; try { await insertImage(file); } catch (error) { setStatus(errorMessage(error), true); } });
  $('editor').addEventListener('paste', async (event) => { const file = [...event.clipboardData.files].find((item) => item.type.startsWith('image/')); if (!file) return; event.preventDefault(); try { await insertImage(file); } catch (error) { setStatus(errorMessage(error), true); } });
  $('new-blog').addEventListener('click', () => { state.current = null; setEditorMode('blog'); fill({}, ''); $('delete-button').hidden = true; });
  $('new-writeup').addEventListener('click', () => { state.current = null; setEditorMode('writeups'); fill({}, ''); $('delete-button').hidden = true; });
  $('article-search').addEventListener('input', renderList); $('collection-filter').addEventListener('change', renderList);
  $('save-draft').addEventListener('click', () => save(true).catch((error) => setStatus(errorMessage(error), true)));
  $('article-form').addEventListener('submit', (event) => { event.preventDefault(); save(false).catch((error) => setStatus(errorMessage(error), true)); });
  $('cover-file').addEventListener('change', () => $('cover-file').files[0] && upload($('cover-file').files[0]).catch((error) => setStatus(errorMessage(error), true)));
  $('delete-button').addEventListener('click', async () => { if (!state.current || !confirm('Delete this article permanently?')) return; try { await request(`${api}?action=delete&collection=${state.collection}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'delete', path: state.current.path, sha: state.current.sha }) }); state.current = null; setEditorMode(null); fill({}, ''); $('delete-button').hidden = true; setStatus('Article deleted.'); await loadList(); } catch (error) { setStatus(errorMessage(error), true); } });
  $('preview-button').addEventListener('click', () => { $('preview-content').innerHTML = editor.getHTML(); $('preview-dialog').showModal(); });
  $('logout').addEventListener('click', () => { window.location.href = `${auth}?route=logout`; });
  async function init() {
    try { const me = await request(`${auth}?route=me`); state.csrf = me.csrf; $('login-panel').hidden = true; $('admin-app').hidden = false; setText('user-name', me.login); await loadList(); }
    catch (error) { $('login-error').hidden = false; $('login-error').textContent = new URLSearchParams(location.search).get('login') === 'success' ? `Login could not be verified: ${errorMessage(error)}` : ''; }
  }
  init();
</script>

<style>
  .admin-page { max-width: 90rem; }
  .admin-heading { max-width: 48rem; margin-bottom: var(--space-4); }
  .admin-heading h1 { font-size: var(--text-3xl); margin-block: .35rem var(--space-1); }
  .admin-panel { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-3); box-shadow: 0 12px 28px rgba(0,0,0,.12); }
  .dashboard-toolbar, .editor-top, .editor-footer, .list-heading { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); }
  .dashboard-toolbar { margin-bottom: var(--space-3); }
  .toolbar-actions, .editor-actions { display: flex; flex-wrap: wrap; gap: .5rem; }
  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-2); margin-bottom: var(--space-3); }
  .stat-card { display: grid; gap: .25rem; padding: var(--space-2); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface-raised); }
  .stat-card strong { font-size: var(--text-xl); }
  .stat-card span, .field-help, small { color: var(--color-text-secondary); font-size: var(--text-xs); }
  .dashboard-layout { display: grid; grid-template-columns: minmax(17rem, .32fr) minmax(0, 1fr); gap: var(--space-3); align-items: start; }
  .article-list-panel { position: sticky; top: 5rem; }
  .list-heading { margin-bottom: var(--space-2); }
  .list-heading h2, .editor-top h2 { font-size: var(--text-lg); }
  input, textarea, select { width: 100%; color: var(--color-text-primary); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: .65rem .75rem; font: inherit; }
  .article-list-panel > input { margin-bottom: var(--space-2); }
  .article-list-item { display: grid; width: 100%; gap: .25rem; text-align: left; color: var(--color-text-secondary); background: transparent; border: 0; border-bottom: 1px solid var(--color-border); padding: .75rem 0; cursor: pointer; }
  .article-list-item:hover { color: var(--color-accent-strong); }
  .article-list-item span { font-size: var(--text-xs); }
  .field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); margin-top: var(--space-2); }
  label { display: grid; gap: .35rem; font-size: var(--text-sm); color: var(--color-text-secondary); }
  fieldset { display: grid; gap: var(--space-2); border: 1px solid var(--color-border); border-radius: var(--radius-md); margin: var(--space-3) 0; padding: var(--space-2); }
  legend { color: var(--color-text-primary); padding-inline: .5rem; }
