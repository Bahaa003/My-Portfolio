---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Publishing Studio" description="Private publishing studio.">
  <section class="page section admin-page">
    <div class="admin-heading">
      <p class="mono text-secondary">Private publishing studio</p>
      <h1>Article editor</h1>
      <p class="text-secondary">Create and publish Blog posts or Security write-ups directly to the repository.</p>
    </div>

    <div id="admin-login" class="admin-panel">
      <h2>Sign in to publish</h2>
      <p class="text-secondary">Only the configured GitHub account can access this editor.</p>
      <a class="admin-button admin-button-primary" href="/.netlify/functions/admin-auth?route=start">Continue with GitHub</a>
    </div>

    <div id="admin-app" hidden>
      <div class="admin-toolbar">
        <label>
          Collection
          <select id="collection-select">
            <option value="blog">Blog</option>
            <option value="writeups">Write-ups</option>
          </select>
        </label>
        <button id="new-article" class="admin-button admin-button-secondary" type="button">New article</button>
        <button id="logout" class="admin-button admin-button-quiet" type="button">Sign out</button>
      </div>

      <div class="admin-layout">
        <aside class="admin-panel article-list-panel">
          <h2>Articles</h2>
          <p id="article-list-status" class="text-secondary">Loading...</p>
          <div id="article-list"></div>
        </aside>

        <form id="article-form" class="admin-panel editor-panel">
          <div class="editor-heading">
            <div>
              <p class="mono text-secondary" id="editor-mode">New article</p>
              <h2 id="editor-title">Create article</h2>
            </div>
            <button id="delete-article" class="admin-button admin-button-danger" type="button" hidden>Delete</button>
          </div>

          <div class="field-grid">
            <label>Title<input id="title" required maxlength="180" /></label>
            <label>Publication date<input id="date" type="date" required /></label>
          </div>
          <label>Description / excerpt<textarea id="description" rows="3" maxlength="300" required></textarea></label>
          <div class="field-grid">
            <label>Tags <span class="field-help">comma separated</span><input id="tags" placeholder="web security, research" /></label>
            <label>Cover image<input id="cover-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" /><small id="cover-status">Optional</small></label>
          </div>

          <div id="writeup-fields" hidden>
            <div class="field-grid">
              <label>Category<select id="category"><option value="web">Web</option><option value="api">API</option><option value="auth">Auth</option><option value="misconfig">Misconfiguration</option><option value="recon">Recon</option><option value="other">Other</option></select></label>
              <label>Difficulty<select id="difficulty"><option value="">Not specified</option><option value="easy">Easy</option><option value="medium">Medium</option><option value="hard">Hard</option></select></label>
            </div>
            <label>Technologies <span class="field-help">comma separated</span><input id="technologies" placeholder="Burp Suite, HTTP" /></label>
          </div>

          <label>Content <span class="field-help">Markdown or MDX. Code fences, tables, HTTP blocks, callouts, and images are supported.</span><textarea id="content" rows="22" required></textarea></label>
          <div class="editor-actions">
            <label class="image-upload">Insert article image<input id="article-image" type="file" accept="image/png,image/jpeg,image/webp,image/gif" /></label>
            <button class="admin-button admin-button-primary" type="submit">Publish to GitHub</button>
          </div>
          <p id="form-status" class="form-status" role="status"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const apiUrl = '/.netlify/functions/admin-api';
  const authUrl = '/.netlify/functions/admin-auth';
  const state = { collection: 'blog', current: null };
  const $ = (id) => document.getElementById(id);

  function setStatus(message, error = false) {
    const element = $('form-status');
    element.textContent = message;
    element.classList.toggle('is-error', error);
  }

  function slugify(value) {
    return value.toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 90) || 'article';
  }

  function listValue(value) {
    return value.split(',').map((item) => item.trim()).filter(Boolean);
  }

  function parseFrontmatter(source) {
    const match = source.match(/^---\s*\n([\s\S]*?)\n---\s*\n?([\s\S]*)$/);
    if (!match) return { fields: {}, body: source };
    const fields = {};
    for (const line of match[1].split('\n')) {
      const separator = line.indexOf(':');
      if (separator < 1) continue;
      const key = line.slice(0, separator).trim();
      const raw = line.slice(separator + 1).trim();
      try { fields[key] = JSON.parse(raw); } catch { fields[key] = raw.replace(/^['"]|['"]$/g, ''); }
    }
    return { fields, body: match[2] };
  }

  function frontmatter(fields, body) {
    const lines = [
      '---',
      `title: ${JSON.stringify(fields.title)}`,
      `description: ${JSON.stringify(fields.description)}`,
      `date: ${fields.date}`,
      `tags: ${JSON.stringify(fields.tags)}`,
      'draft: false',
      'confidentiality: "public"',
    ];
    if (fields.coverUrl) lines.push(`coverUrl: ${JSON.stringify(fields.coverUrl)}`);
    if (state.collection === 'writeups') {
      lines.push(`category: ${JSON.stringify(fields.category || 'other')}`);
      if (fields.difficulty) lines.push(`difficulty: ${JSON.stringify(fields.difficulty)}`);
      lines.push(`technologies: ${JSON.stringify(fields.technologies)}`);
      lines.push('featured: false');
    }
    return `${lines.join('\n')}\n---\n\n${body.trim()}\n`;
  }

  async function request(url, options) {
    const response = await fetch(url, { credentials: 'same-origin', ...options });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || 'Request failed.');
    return data;
  }

  async function loadList() {
    const status = $('article-list-status');
    const list = $('article-list');
    list.replaceChildren();
    status.textContent = 'Loading...';
    try {
      const entries = await request(`${apiUrl}?action=list&collection=${state.collection}`);
      status.textContent = entries.length ? `${entries.length} article${entries.length === 1 ? '' : 's'}` : 'No published articles yet.';
      for (const entry of entries) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'article-list-item';
        button.textContent = entry.name.replace(/\.mdx$/, '').replace(/-/g, ' ');
        button.addEventListener('click', () => loadArticle(entry));
        list.append(button);
      }
    } catch (error) {
      status.textContent = error.message;
    }
  }

  function setEditor(fields = {}, body = '') {
    $('title').value = fields.title || '';
    $('description').value = fields.description || '';
    $('date').value = fields.date || new Date().toISOString().slice(0, 10);
    $('tags').value = (fields.tags || []).join(', ');
    $('technologies').value = (fields.technologies || []).join(', ');
    $('category').value = fields.category || 'web';
    $('difficulty').value = fields.difficulty || '';
    $('content').value = body;
    state.coverUrl = fields.coverUrl || '';
    $('cover-status').textContent = fields.coverUrl ? `Current: ${fields.coverUrl}` : 'Optional';
    state.current = state.current ? { ...state.current, fields } : null;
    $('editor-mode').textContent = state.current ? `Editing ${state.current.name}` : 'New article';
    $('editor-title').textContent = state.current ? 'Edit article' : 'Create article';
    $('delete-article').hidden = !state.current;
    $('writeup-fields').hidden = state.collection !== 'writeups';
  }

  async function loadArticle(entry) {
    try {
      const data = await request(`${apiUrl}?action=read&collection=${state.collection}&path=${encodeURIComponent(entry.path)}`);
      state.current = entry;
      const parsed = parseFrontmatter(data.content);
      state.current.sha = data.sha;
      setEditor(parsed.fields, parsed.body);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch (error) { setStatus(error.message, true); }
  }

  async function uploadImage(file, purpose) {
    const bytes = new Uint8Array(await file.arrayBuffer());
    let binary = '';
    for (const byte of bytes) binary += String.fromCharCode(byte);
    const slug = slugify($('title').value);
    const data = await request(apiUrl, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'upload', collection: state.collection, slug, name: file.name.replace(/[^a-zA-Z0-9_.-]/g, '-'), contentBase64: btoa(binary) }) });
    if (purpose === 'cover') {
      state.coverUrl = data.url;
      $('cover-status').textContent = `Uploaded: ${data.url}`;
    } else {
      const textarea = $('content');
      const markdown = `![${file.name}](${data.url})`;
      textarea.setRangeText(`\n${markdown}\n`, textarea.selectionStart, textarea.selectionEnd, 'end');
      textarea.focus();
    }
  }

  async function init() {
    try {
      await request(`${authUrl}?route=me`);
      $('admin-login').hidden = true;
      $('admin-app').hidden = false;
      setEditor();
      await loadList();
    } catch (error) {
      $('admin-login').hidden = false;
      if (new URLSearchParams(window.location.search).get('login') === 'success') {
        const message = document.createElement('p');
        message.className = 'form-status is-error';
        message.textContent = `Login completed, but the editor session could not be verified: ${error.message}`;
        $('admin-login').append(message);
      }
    }
  }

  $('collection-select').addEventListener('change', async (event) => {
    state.collection = event.target.value;
    state.current = null;
    setEditor();
    await loadList();
  });
  $('new-article').addEventListener('click', () => { state.current = null; setEditor(); setStatus(''); });
  $('logout').addEventListener('click', () => { window.location.href = `${authUrl}?route=logout`; });
  $('cover-file').addEventListener('change', (event) => event.target.files[0] && uploadImage(event.target.files[0], 'cover').catch((error) => setStatus(error.message, true)));
  $('article-image').addEventListener('change', (event) => event.target.files[0] && uploadImage(event.target.files[0], 'body').catch((error) => setStatus(error.message, true)));
  $('delete-article').addEventListener('click', async () => {
    if (!state.current || !confirm('Delete this article from GitHub?')) return;
    try {
      await request(`${apiUrl}?action=delete&collection=${state.collection}&path=${encodeURIComponent(state.current.path)}&sha=${encodeURIComponent(state.current.sha)}`, { method: 'POST' });
      state.current = null; setEditor(); setStatus('Deleted. Netlify will deploy the change.'); await loadList();
    } catch (error) { setStatus(error.message, true); }
  });
  $('article-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    try {
      const fields = { title: $('title').value.trim(), description: $('description').value.trim(), date: $('date').value, tags: listValue($('tags').value), technologies: listValue($('technologies').value), category: $('category').value, difficulty: $('difficulty').value, coverUrl: state.coverUrl || state.current?.fields?.coverUrl || '' };
      if (!fields.title || !fields.description || !fields.date || !$('content').value.trim()) throw new Error('Title, description, date, and content are required.');
      const name = state.current?.name || `${slugify(fields.title)}.mdx`;
      await request(apiUrl, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'save', collection: state.collection, name, sha: state.current?.sha, content: frontmatter(fields, $('content').value) }) });
      setStatus('Published to GitHub. Netlify will deploy automatically.');
      await loadList();
    } catch (error) { setStatus(error.message, true); }
  });

  init();
</script>

<style>
  .admin-page { max-width: 78rem; }
  .admin-heading { max-width: 48rem; margin-bottom: var(--space-4); }
  .admin-heading h1 { font-size: var(--text-3xl); margin-block: .35rem var(--space-1); }
  .admin-panel { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-3); box-shadow: 0 12px 28px rgba(0, 0, 0, .12); }
  .admin-panel h2 { font-size: var(--text-lg); margin-bottom: var(--space-1); }
  .admin-button { display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); padding: .65rem 1rem; cursor: pointer; font-size: var(--text-sm); transition: background var(--transition-fast), border-color var(--transition-fast); }
  .admin-button-primary { background: var(--color-accent); color: #17191c; border-color: var(--color-accent); }
  .admin-button-primary:hover { background: var(--color-accent-strong); }
  .admin-button-secondary { background: var(--color-surface-raised); }
  .admin-button-quiet { background: transparent; color: var(--color-text-secondary); }
  .admin-button-danger { background: transparent; color: #f0a6a6; border-color: #8e4c4c; }
  .admin-toolbar { display: flex; align-items: end; gap: var(--space-2); margin-bottom: var(--space-3); }
  .admin-toolbar label { display: grid; gap: .35rem; font-size: var(--text-xs); color: var(--color-text-secondary); }
  .admin-toolbar select, input, textarea, select { width: 100%; color: var(--color-text-primary); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: .65rem .75rem; font: inherit; }
  .admin-toolbar select { min-width: 10rem; }
  .admin-toolbar .admin-button-quiet { margin-left: auto; }
  .admin-layout { display: grid; grid-template-columns: minmax(15rem, .32fr) minmax(0, 1fr); gap: var(--space-3); align-items: start; }
  .article-list-panel { position: sticky; top: 5rem; }
  .article-list-item { display: block; width: 100%; text-align: left; color: var(--color-text-secondary); background: transparent; border: 0; border-bottom: 1px solid var(--color-border); padding: .75rem 0; cursor: pointer; }
  .article-list-item:hover { color: var(--color-accent-strong); }
  .editor-heading { display: flex; align-items: start; justify-content: space-between; gap: var(--space-2); margin-bottom: var(--space-3); }
  .editor-heading h2 { font-size: var(--text-2xl); }
  .field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); }
  .editor-panel label { display: grid; gap: .4rem; margin-bottom: var(--space-2); color: var(--color-text-secondary); font-size: var(--text-sm); }
  .editor-panel input, .editor-panel textarea, .editor-panel select { margin-top: .1rem; }
  .editor-panel textarea { resize: vertical; line-height: 1.55; }
  .field-help, .editor-panel small { color: var(--color-text-secondary); font-size: var(--text-xs); font-weight: 400; }
  .editor-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2); margin-top: var(--space-2); }
  .image-upload { display: inline-flex !important; width: auto; margin: 0 !important; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: .65rem 1rem; cursor: pointer; }
  .image-upload input { display: none; }
  .form-status { min-height: 1.5rem; margin-top: var(--space-2); color: var(--color-accent-strong); }
  .form-status.is-error { color: #f0a6a6; }
  @media (max-width: 760px) { .admin-toolbar, .field-grid { grid-template-columns: 1fr; display: grid; align-items: stretch; }.admin-toolbar .admin-button-quiet { margin-left: 0; }.admin-layout { grid-template-columns: 1fr; }.article-list-panel { position: static; }.editor-actions { align-items: stretch; }.editor-actions > * { width: 100%; } }
</style>