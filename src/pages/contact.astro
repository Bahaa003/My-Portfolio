---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SOCIAL_LINKS } from '../config/site';
---

<BaseLayout title="Contact" description="Contact Bahaa Aldeen Nawlo.">
  <section class="page section prose-width">
    <p class="mono text-secondary">Contact</p>
    <h1>Get in touch</h1>
    <p class="text-secondary intro-text">
      For professional opportunities, security research, or questions about my work, you can reach me through email or LinkedIn.
    </p>

    <ul class="contact-list">
      {SOCIAL_LINKS.map((social) => (
        <li>
          <a
            href={social.href}
            rel={social.href.startsWith('http') ? 'noreferrer' : undefined}
            target={social.href.startsWith('http') ? '_blank' : undefined}
          >
            <span>{social.label}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  h1 {
    font-size: var(--text-3xl);
    margin-block: 0.25rem var(--space-2);
  }

  .intro-text {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .contact-list li {
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .contact-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-2);
    font-size: var(--text-base);
    transition: color var(--transition-fast), padding-left var(--transition-fast);
  }

  .contact-list a:hover {
    color: var(--color-accent-strong);
    padding-left: 0.35rem;
  }

  .arrow {
    color: var(--color-text-secondary);
  }
</style>
