---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConfidentialityNotice from '../../components/ui/ConfidentialityNotice.astro';
import Tag from '../../components/ui/Tag.astro';
import Badge from '../../components/ui/Badge.astro';
import { getPublicProjects, entrySlug } from '../../lib/collections';

export async function getStaticPaths() {
  const projects = await getPublicProjects();
  return projects.map((entry) => ({
    params: { slug: entrySlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const dateStr = entry.data.date
  ? entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

const categoryLabel: Record<string, string> = {
  'professional-security-work': 'Professional Security Work',
  'security-investigation': 'Security Investigation',
  'personal-project': 'Personal Project',
  research: 'Research',
};
---

<BaseLayout title={entry.data.title} description={entry.data.description} type="article">
  <article class="page section">
    <div class="prose-width">
      <p class="mono text-secondary">{categoryLabel[entry.data.category]}</p>
      <h1>{entry.data.title}</h1>
      <p class="project-meta mono text-secondary">
        {dateStr ? `${dateStr} · ` : ''}<Badge tone={entry.data.status === 'completed' ? 'success' : 'neutral'}>{entry.data.status}</Badge>
      </p>

      {entry.data.tags.length > 0 && (
        <div class="project-tags">
          {entry.data.tags.map((tag) => <Tag>{tag}</Tag>)}
        </div>
      )}

      {entry.data.confidentiality !== 'public' && (
        <ConfidentialityNotice level={entry.data.confidentiality} />
      )}
    </div>

    <div class="prose-width article-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  h1 {
    font-size: var(--text-3xl);
    margin-block: 0.25rem var(--space-2);
  }

  .project-meta {
    font-size: var(--text-sm);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-2);
  }

  .article-body {
    margin-top: var(--space-4);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .article-body :global(h2) {
    font-size: var(--text-xl);
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
  }

  .article-body :global(p) {
    margin-block: var(--space-2);
  }

  .article-body :global(ul) {
    margin-block: var(--space-2);
    padding-left: 1.25rem;
    list-style: disc;
  }

  .article-body :global(a) {
    color: var(--color-accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
