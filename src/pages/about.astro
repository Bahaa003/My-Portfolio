---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import { PROFILE } from '../data/profile';
import { CV } from '../data/cv';

// Curated, homepage-sized groupings of real CV content. Every item below
// restates something already present in src/data/cv.ts (CV.experience
// highlights / CV.skills) in plain language — nothing new is introduced,
// and no client, target, or confidential detail is named.
const practicalExperience = [
  'Web application security assessments',
  'API security testing',
  'Authentication and authorization testing',
  'Session and application behavior analysis',
  'Security configuration assessments',
  'HTTP security header analysis',
  'TLS/HTTP security controls',
  'DNS exposure review',
  'Security misconfiguration review',
  'Vulnerability identification and validation',
  'Technical security reporting',
] as const;

const methodology = [
  {
    eyebrow: '01',
    title: 'Understand',
    description:
      "Map the application's functionality, endpoints, authentication mechanisms, authorization boundaries, inputs, exposed services, and relevant security controls.",
  },
  {
    eyebrow: '02',
    title: 'Validate',
    description:
      'Analyze requests and responses, test relevant security controls, reproduce potential weaknesses, and distinguish confirmed findings from expected behavior.',
  },
  {
    eyebrow: '03',
    title: 'Document',
    description:
      'Record evidence, affected components, technical details, impact, and appropriate remediation recommendations.',
  },
] as const;

const securityTopics = [
  'Web Application Security',
  'API Security',
  'Authentication & Authorization',
  'JWT Security Testing',
  'OWASP Top 10',
  'XSS',
  'SQL Injection',
  'SSRF',
  'CSRF',
  'Path Traversal',
  'Access Control',
  'Clickjacking',
  'Security Misconfiguration',
] as const;
---

<BaseLayout
  title="About"
  description="Background, working methodology, and technical focus of Bahaa Aldeen Nawlo, Junior Web Penetration Tester."
>
  <!-- Intro / professional positioning -->
  <section class="page section">
    <div class="prose-width stack">
      <div>
        <p class="mono text-secondary">About</p>
        <h1>{PROFILE.name}</h1>
        <p class="about-title text-secondary">{PROFILE.title}</p>
        <p class="about-focus mono text-secondary">{PROFILE.focusAreas.join(' · ')}</p>
      </div>

      <p class="about-paragraph">{PROFILE.longIntro[0]}</p>
    </div>
  </section>

  <!-- Practical experience -->
  <section class="page section-tight">
    <div class="prose-width">
      <SectionHeading title="Practical experience" />
      <p class="about-paragraph text-secondary">
        My assessment work is authorized and scoped in advance. I don't name clients, targets, or
        confidential findings here — the list below describes the type of work involved, not any
        specific engagement.
      </p>
      <ul class="experience-list">
        {practicalExperience.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <!-- How I work -->
  <section class="page section-tight">
    <div class="page-inner">
      <SectionHeading title="How I work" />
      <div class="method-grid">
        {
          methodology.map((step) => (
            <article class="method-step">
              <span class="mono text-secondary">{step.eyebrow}</span>
              <h3>{step.title}</h3>
              <p class="text-secondary">{step.description}</p>
            </article>
          ))
        }
      </div>
      <p class="method-note text-secondary">
        This describes my general working approach — not every assessment follows these steps in
        exactly the same way or order.
      </p>
    </div>
  </section>

  <!-- Technical focus -->
  <section class="page section-tight">
    <div class="page-inner">
      <SectionHeading title="Technical focus" href="/cv" linkLabel="Full technical skills" />
      <div class="focus-grid">
        <div class="focus-group">
          <h3 class="mono text-secondary">Security topics</h3>
          <ul>
            {securityTopics.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="focus-group">
          <h3 class="mono text-secondary">Tooling</h3>
          <ul>
            {CV.skills.tools.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Education & training -->
  <section class="page section-tight">
    <div class="prose-width">
      <SectionHeading title="Education & training" href="/cv" linkLabel="Full CV" />

      <div class="edu-block">
        <h3 class="mono text-secondary">Education</h3>
        {
          CV.education.map((e) => (
            <p>
              {e.degree} — <span class="text-secondary">{e.institution}, {e.year}</span>
            </p>
          ))
        }
      </div>

      <div class="edu-block">
        <h3 class="mono text-secondary">Certifications</h3>
        <ul class="edu-list">
          {
            CV.certifications.map((c) => (
              <li>
                {c.name} — <span class="text-secondary">{c.issuer}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="edu-block">
        <h3 class="mono text-secondary">Training</h3>
        <ul class="edu-list">
          {
            CV.training.map((t) => (
              <li>
                {t.name} — <span class="text-secondary">{t.detail}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Languages -->
  <section class="page section-tight">
    <div class="prose-width">
      <SectionHeading title="Languages" />
      <ul class="lang-list">
        {
          CV.languages.map((l) => (
            <li>
              <span>{l.language}</span>
              <span class="text-secondary mono">{l.level}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Contact / next step -->
  <section class="page section-tight">
    <div class="prose-width contact-cta">
      <h2>Next step</h2>
      <p class="text-secondary">
        Take a look at the work, review the full CV, or get in touch directly.
      </p>
      <div class="cta-buttons">
        <Button href="/work" variant="secondary">View my work</Button>
        <Button href="/cv" variant="secondary">View CV</Button>
        <Button href="/contact" variant="primary">Contact</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    font-size: var(--text-3xl);
    margin-top: 0.25rem;
  }

  .about-title {
    font-size: var(--text-lg);
    margin-top: var(--space-1);
  }

  .about-focus {
    font-size: var(--text-sm);
    margin-top: var(--space-1);
  }

  .about-paragraph {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  h2 {
    font-size: var(--text-lg);
  }

  /* Widens sections that need a grid beyond prose width, while keeping
     them visually aligned with the rest of the page's gutter. */
  .page-inner {
    max-width: var(--max-width-page);
  }

  /* Practical experience */
  .experience-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem var(--space-4);
    margin-top: var(--space-3);
  }

  .experience-list li {
    position: relative;
    padding-left: 1rem;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  .experience-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 5px;
    height: 1px;
    background: var(--color-accent);
  }

  @media (max-width: 640px) {
    .experience-list {
      grid-template-columns: 1fr;
    }
  }

  /* How I work */
  .method-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .method-step {
    border-top: var(--border-width) solid var(--color-border-strong);
    padding-top: var(--space-2);
  }

  .method-step h3 {
    font-size: var(--text-lg);
    margin-block: var(--space-1);
  }

  .method-step p {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .method-note {
    font-size: var(--text-xs);
    margin-top: var(--space-3);
    max-width: 60ch;
  }

  @media (max-width: 760px) {
    .method-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }

  /* Technical focus */
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .focus-group h3 {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-2);
    padding-bottom: var(--space-1);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .focus-group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .focus-group li {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.55rem;
  }

  @media (max-width: 640px) {
    .focus-grid {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }

  /* Education & training */
  .edu-block {
    margin-top: var(--space-3);
  }

  .edu-block h3 {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-1);
  }

  .edu-block p {
    font-size: var(--text-sm);
  }

  .edu-list li {
    font-size: var(--text-sm);
    padding-block: 0.3rem;
  }

  /* Languages */
  .lang-list li {
    display: flex;
    justify-content: space-between;
    max-width: 24rem;
    padding-block: var(--space-1);
    border-bottom: var(--border-width) solid var(--color-border);
    font-size: var(--text-sm);
  }

  /* Contact / next step */
  .contact-cta h2 {
    margin-bottom: var(--space-1);
  }

  .contact-cta p {
    margin-bottom: var(--space-3);
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
