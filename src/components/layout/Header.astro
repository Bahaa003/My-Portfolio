---
import Nav from './Nav.astro';
import { SITE } from '../../config/site';
import { withBase } from '../../lib/urls';
---

<header class="site-header">
  <div class="page site-header-inner">
    <a href={withBase('/')} class="site-brand">{SITE.shortTitle}</a>
    <Nav />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(28, 30, 34, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: var(--border-width) solid rgba(197, 201, 207, 0.18);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-2);
    position: relative;
  }

  .site-brand {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent-strong);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
</style>
