---
import { NAV_LINKS, SOCIAL_LINKS, SITE } from '../../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="page footer-inner">
    <div class="footer-links">
      {
        NAV_LINKS.map((link, i) => (
          <>
            <a href={link.href}>{link.label}</a>
            {i < NAV_LINKS.length - 1 && <span aria-hidden="true">·</span>}
          </>
        ))
      }
    </div>

    <div class="footer-socials">
      {
        SOCIAL_LINKS.map((social) => (
          <a href={social.href} rel="me noreferrer" target={social.href.startsWith('http') ? '_blank' : undefined}>
            {social.label}
          </a>
        ))
      }
    </div>

    <p class="footer-copy text-secondary">© {year} {SITE.shortTitle}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-width) solid var(--color-border);
    padding-block: var(--space-4);
    margin-top: var(--space-6);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: center;
    text-align: center;
  }

  .footer-links,
  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .footer-links a,
  .footer-socials a {
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover,
  .footer-socials a:hover {
    color: var(--color-text-primary);
  }

  .footer-copy {
    font-size: var(--text-xs);
    margin-top: var(--space-1);
  }
</style>
