---
import SectionHeading from '../ui/SectionHeading.astro';
import { withBase } from '../../lib/urls';
---

<section class="section-tight">
  <div class="page">
    <SectionHeading title="About" href={withBase('/about')} linkLabel="More about me" />
    <p class="prose-width about-preview-text">
      Computer Science graduate focused on web application security, API security, and practical
      security assessment work. I continue developing through hands-on labs, research, and
      technical documentation.
    </p>
  </div>
</section>

<style>
  .about-preview-text {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }
</style>
