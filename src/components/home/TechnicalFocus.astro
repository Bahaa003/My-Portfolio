---
import SectionHeading from '../ui/SectionHeading.astro';
import { CV } from '../../data/cv';

// Curated, homepage-sized subset of src/data/cv.ts — shortened labels
// (e.g. "Authentication & Authorization" instead of the CV's
// "Authentication & Authorization Testing") refer to the same skills
// listed in the full CV; nothing new is introduced here. The complete
// list (including Dart/Flutter, n8n, GraphQL, Django, OS, etc.) stays on
// the /cv page.
const webApiSecurity = [
  'OWASP Top 10',
  'Authentication & Authorization',
  'JWT Security Testing',
  'SQL Injection',
  'Cross-Site Scripting (XSS)',
  'SSRF',
  'CSRF',
  'Path Traversal',
  'Access Control Flaws',
] as const;

const programming = ['Python', 'Bash Scripting'] as const;

const groups = [
  { label: 'Web & API Security', items: webApiSecurity },
  { label: 'Tooling', items: CV.skills.tools },
  { label: 'Programming & Scripting', items: programming },
] as const;
---

<section class="section-tight">
  <div class="page">
    <SectionHeading title="Technical focus" href="/cv" linkLabel="Full technical skills" />
    <div class="focus-grid">
      {
        groups.map((group) => (
          <div class="focus-group">
            <h3 class="mono text-secondary">{group.label}</h3>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .focus-group h3 {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-2);
    padding-bottom: var(--space-1);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .focus-group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .focus-group li {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.55rem;
  }

  @media (max-width: 760px) {
    .focus-grid {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
