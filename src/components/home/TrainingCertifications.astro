---
import SectionHeading from '../ui/SectionHeading.astro';
import { CV } from '../../data/cv';

// Sourced directly from src/data/cv.ts — nothing invented here.
const certEntries = CV.certifications.map((c) => ({
  kind: 'Certification' as const,
  name: c.name,
  detail: c.issuer,
}));

const trainingEntries = CV.training.map((t) => ({
  kind: 'Training' as const,
  name: t.name,
  detail: t.detail,
}));

const entries = [...certEntries, ...trainingEntries];
---

<section class="section-tight">
  <div class="page">
    <SectionHeading title="Training & certifications" href="/cv" linkLabel="Full CV" />
    <ul class="training-list">
      {
        entries.map((entry) => (
          <li class="training-row">
            <span class="mono text-secondary training-kind">{entry.kind}</span>
            <span class="training-name">{entry.name}</span>
            <span class="text-secondary training-detail">{entry.detail}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .training-list {
    display: flex;
    flex-direction: column;
  }

  .training-row {
    display: grid;
    grid-template-columns: 8.5rem 1fr 1fr;
    gap: var(--space-2);
    align-items: baseline;
    padding-block: var(--space-2);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .training-kind {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .training-name {
    font-size: var(--text-base);
  }

  .training-detail {
    font-size: var(--text-sm);
  }

  @media (max-width: 640px) {
    .training-row {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
