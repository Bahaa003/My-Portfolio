---
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import { withBase } from '../../lib/urls';

// Curated, non-identifying categories of work. Deliberately static rather
// than pulled from the projects collection: these are stable category
// descriptions, not individual case studies, and must never reference a
// client, employer, or confidential target.
const categories = [
  {
    eyebrow: '01',
    title: 'Web & API Security Assessments',
    scope: 'Web applications · APIs',
    focus: 'Authentication · Authorization · Session handling · JWT · Common web vulnerabilities',
    work: 'Request/response analysis · Vulnerability validation · Evidence collection · Technical reporting',
    href: withBase('/projects/redacted-security-assessments'),
  },
  {
    eyebrow: '02',
    title: 'Configuration Assessments',
    scope: 'Externally observable infrastructure and application configuration',
    focus: 'HTTP security headers · TLS/HTTP controls · DNS exposure · Security configuration',
    work: 'Configuration review · Evidence collection · Risk documentation · Remediation recommendations',
    href: withBase('/work'),
  },
  {
    eyebrow: '03',
    title: 'Security Investigation',
    scope: 'Publicly accessible web assets',
    focus: 'Application and infrastructure analysis · Technical research · Evidence collection',
    work: 'Investigation · Documentation · Technical analysis',
    href: withBase('/projects/security-investigation'),
  },
] as const;
---

<section class="section-tight">
  <div class="page">
    <SectionHeading title="Selected security work" href={withBase('/work')} linkLabel="View all work" />
    <div class="grid-auto">
      {
        categories.map((c) => (
          <Card href={c.href}>
            <article class="work-category">
              <span class="mono text-secondary">{c.eyebrow}</span>
              <h3>{c.title}</h3>

              <dl>
                <div>
                  <dt class="mono text-secondary">Scope</dt>
                  <dd>{c.scope}</dd>
                </div>
                <div>
                  <dt class="mono text-secondary">Focus</dt>
                  <dd>{c.focus}</dd>
                </div>
                <div>
                  <dt class="mono text-secondary">Work</dt>
                  <dd>{c.work}</dd>
                </div>
              </dl>
            </article>
          </Card>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work-category {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-height: 100%;
  }

  .work-category h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-1);
  }

  .work-category dl {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .work-category dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.2rem;
  }

  .work-category dd {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }
</style>
