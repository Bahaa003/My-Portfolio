---
import Button from '../ui/Button.astro';
import { PROFILE } from '../../data/profile';
import { SOCIAL_LINKS } from '../../config/site';
import { withBase } from '../../lib/urls';
---

<section class="hero section">
  <div class="page hero-grid">
    <div class="hero-copy">
      <p class="hero-eyebrow mono text-secondary">{PROFILE.title}</p>
      <h1 class="hero-name">{PROFILE.name}</h1>
      <p class="hero-focus text-secondary">{PROFILE.focusAreas.join(' · ')}</p>
      <p class="hero-summary">{PROFILE.shortIntro}</p>

      <div class="hero-ctas">
        <Button href={withBase('/work')} variant="primary">View My Work</Button>
        <Button href={withBase('/cv')} variant="secondary">View CV</Button>
      </div>

      <nav class="hero-links" aria-label="Professional profiles">
        {
          SOCIAL_LINKS.map((social) => (
            <a
              href={social.href}
              rel="me noreferrer"
              target={social.href.startsWith('http') ? '_blank' : undefined}
            >
              {social.label}
            </a>
          ))
        }
      </nav>
    </div>

    <aside class="hero-aside" aria-label="Profile highlights">
      <img class="hero-photo" src={withBase('/images/profile/Photo.jpeg')} alt="Bahaa Aldeen Nawlo" />
      <div class="hero-facts">
        <div class="fact">
          <strong>6</strong>
          <span>security reports authored</span>
        </div>
        <div class="fact">
          <strong>2</strong>
          <span>additional reports reviewed</span>
        </div>
        <div class="fact">
          <strong>2026</strong>
          <span>Computer Science graduate</span>
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(4rem, 10vw, 7rem);
    padding-bottom: clamp(3rem, 8vw, 5rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 280px);
    gap: var(--space-6);
    align-items: center;
  }

  .hero-eyebrow {
    font-size: var(--text-sm);
    margin-bottom: var(--space-1);
  }

  .hero-name {
    font-size: clamp(2.1rem, 5vw, 4.5rem);
    white-space: nowrap;
    max-width: none;
    letter-spacing: -0.055em;
  }

  .hero-focus {
    font-size: var(--text-lg);
    margin-top: var(--space-2);
    max-width: 42ch;
  }

  .hero-summary {
    max-width: 62ch;
    margin-top: var(--space-3);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .hero-links a:hover {
    color: var(--color-accent-strong);
  }

  .hero-aside {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
  }

  .hero-photo {
    width: clamp(150px, 18vw, 220px);
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center 15%;
    border-radius: 50%;
    border: 2px solid var(--color-accent);
    box-shadow: 0 0 0 8px rgba(197, 201, 207, 0.08), 0 16px 40px rgba(0, 0, 0, 0.2);
  }

  .hero-facts {
    width: 100%;
    border-top: var(--border-width) solid var(--color-border);
  }

  .fact {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--space-2);
    padding-block: var(--space-2);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .fact strong {
    font-size: var(--text-xl);
    color: var(--color-accent-strong);
  }

  .fact span {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    align-self: center;
  }

  @media (max-width: 800px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      align-items: start;
    }

    .hero-name {
      max-width: none;
    }

    .hero-aside {
      grid-template-columns: auto 1fr;
      align-items: center;
      justify-items: start;
    }

    .hero-photo {
      width: 150px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: var(--space-5);
    }

    .hero-name {
      font-size: clamp(1.75rem, 8vw, 2.8rem);
    }

    .hero-aside {
      grid-template-columns: 1fr;
      justify-items: stretch;
    }

    .hero-photo {
      justify-self: center;
    }
  }
</style>
