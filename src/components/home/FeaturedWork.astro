---
import SectionHeading from '../ui/SectionHeading.astro';
import ProjectCard from '../projects/ProjectCard.astro';
import { getPublicProjects } from '../../lib/collections';

const projects = await getPublicProjects();
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const fallback = featured.length > 0 ? featured : projects.slice(0, 3);
---

{fallback.length > 0 && (
  <section class="section-tight">
    <div class="page">
      <SectionHeading title="Featured work" href="/work" linkLabel="View all work" />
      <div class="grid-auto">
        {fallback.map((entry) => <ProjectCard entry={entry} />)}
      </div>
    </div>
  </section>
)}
