---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SkipToContent from '../components/layout/SkipToContent.astro';
import Seo from '../components/seo/Seo.astro';
import { withBase } from '../lib/urls';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/utilities.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
}

const { title, description, image, noindex, type } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} image={image} noindex={noindex} type={type} />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href={withBase('/rss.xml')} />
  </head>
  <body>
    <SkipToContent />
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
