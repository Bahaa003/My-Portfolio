---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/writeups/TableOfContents.astro';
import ConfidentialityNotice from '../components/ui/ConfidentialityNotice.astro';
import Tag from '../components/ui/Tag.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  date: Date;
  updatedDate?: Date;
  tags: string[];
  headings: Heading[];
  readingMinutes: number;
  confidentiality?: 'public' | 'redacted' | 'private';
  author?: string;
  image?: string;
  coverUrl?: string;
}

const {
  title,
  description,
  date,
  updatedDate,
  tags,
  headings,
  readingMinutes,
  confidentiality,
  author,
  image,
  coverUrl,
} = Astro.props;

const dateStr = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const updatedStr = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} type="article" image={image}>
  <article class="page section">
    <div class="prose-width article-header">
      {author && <p class="mono text-secondary article-author">{author}</p>}
      <h1>{title}</h1>
      <p class="article-meta mono text-secondary">
        {dateStr}
        {updatedStr && ` · Updated ${updatedStr}`}
        {' · '}{readingMinutes} min read
      </p>
      {tags.length > 0 && (
        <div class="article-tags">
          {tags.map((tag) => <Tag>{tag}</Tag>)}
        </div>
      )}
      {coverUrl && <img class="article-cover" src={coverUrl} alt="" />}
    </div>

    <div class="prose-width">
      {confidentiality && confidentiality !== 'public' && (
        <ConfidentialityNotice level={confidentiality} />
      )}
      <TableOfContents headings={headings} />
    </div>

    <div class="prose-width article-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .article-header {
    margin-bottom: var(--space-4);
  }

  .article-header h1 {
    font-size: var(--text-3xl);
    margin-block: var(--space-1) var(--space-2);
  }

  .article-author {
    font-size: var(--text-xs);
  }

  .article-meta {
    font-size: var(--text-sm);
  }

  .article-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin-top: var(--space-3);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-2);
  }

  .article-body {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .article-body :global(h2) {
    font-size: var(--text-xl);
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    scroll-margin-top: 5rem;
  }

  .article-body :global(h3) {
    font-size: var(--text-lg);
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
    scroll-margin-top: 5rem;
  }

  .article-body :global(p) {
    margin-block: var(--space-2);
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-block: var(--space-2);
    padding-left: 1.25rem;
    list-style: disc;
  }

  .article-body :global(ol) {
    list-style: decimal;
  }

  .article-body :global(li) {
    margin-block: 0.4rem;
  }

  .article-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: 3px;
    padding: 0.1rem 0.35rem;
  }

  .article-body :global(pre) {
    background: var(--color-surface) !important;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    overflow-x: auto;
    margin-block: var(--space-3);
  }

  .article-body :global(pre code) {
    background: none;
    border: none;
    padding: 0;
  }

  .article-body :global(img) {
    border-radius: var(--radius-md);
    margin-block: var(--space-3);
  }

  .article-body :global(a) {
    color: var(--color-accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-body :global(blockquote) {
    border-left: 3px solid var(--color-border-strong);
    padding-left: var(--space-2);
    color: var(--color-text-secondary);
    margin-block: var(--space-3);
  }
</style>
